# =============================================================================
# ISL Setu — Environment Configuration
# =============================================================================

# Frontend AI API Endpoint
# Local Development: http://localhost:8000
# Production (Render): https://isl-setu-api.onrender.com
VITE_AI_API_URL=http://localhost:8000

# Supabase Authentication & PostgreSQL Database
# Replace with your actual Supabase project URL and public Anon Key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend CORS Allowed Origins (comma-separated list)
# Production Example: https://isl-healthcare.vercel.app,https://*.vercel.app,http://localhost:5173,http://localhost:5174
ALLOWED_ORIGINS=*
